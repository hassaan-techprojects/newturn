# Neon managed Better Auth (production branch Auth URL)
NEON_AUTH_BASE_URL=https://ep-lingering-tree-bijgbsiq.neonauth.c-5.ap-southeast-1.aws.neon.tech/neondb/auth
# Generate locally with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon pooled PostgreSQL connection string (needed by NewTurn business data APIs)
DATABASE_URL=

# Admin authentication (separate from customer sign-up; configure before enabling admin access)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Object Storage (photos bucket; use `npx neon@latest env pull --service object-storage`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
